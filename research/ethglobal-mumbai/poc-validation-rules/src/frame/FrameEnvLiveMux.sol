pragma solidity 0.8.28;

import {FrameEnv} from "./FrameEnv.sol";

/// FrameEnv on a real EIP-8141 chain with ONE multiplexed raw-bytecode helper instead of six (plan lever:
/// saves 5 cold account accesses = 13k gas per contract under Cancun pricing, 15k under Amsterdam).
///
/// Helper calldata: word0 = kind, word1 = a, word2 = b. Kinds in dispatch order:
///   0 TXPARAM(a=id)  1 FRAMEPARAM(a=frame,b=param)  2 SIGPARAM(a=sig,b=param)
///   3 FRAMEDATALOAD(a=offset,b=frame)  4 RECENTROOTREFLOAD(a=field,b=ref)  5 APPROVE(a=scope)
/// 'a' ends on top of the stack, as in FrameEnvLive / ethrex frame_tx.rs (e.g. FRAMEDATALOAD pops offset first).
/// Bytecode generated by gen_mux.py (119-byte runtime). Never run on a chain yet.
///
/// Calls are inline assembly in the free-memory area (not allocated), so memory does not grow per call.
/// GAS sits right before STATICCALL/DELEGATECALL (Yul evaluates gas() last), which the sidecar allows.
abstract contract FrameEnvLiveMux is FrameEnv {
    address private immutable H;

    error HelperDeployFailed();
    error HelperCallFailed();

    constructor() {
        bytes memory creationCode = hex"6077600d60003960776000f3fe6040356020356000358060001461003a57806001146100455780600214610050578060031461005b5780600414610066578060051461007157fe5b50b060005260206000f35b50b360005260206000f35b50b460005260206000f35b50b160005260206000f35b50b660005260206000f35b50600080aa";
        address h;
        assembly ("memory-safe") {
            h := create(0, add(creationCode, 0x20), mload(creationCode))
        }
        if (h == address(0)) revert HelperDeployFailed();
        H = h;
    }

    function _q(uint256 kind, uint256 a, uint256 b) private view returns (uint256 r) {
        address h = H;
        bool ok;
        assembly ("memory-safe") {
            let p := mload(0x40)
            mstore(p, kind)
            mstore(add(p, 0x20), a)
            mstore(add(p, 0x40), b)
            ok := staticcall(gas(), h, p, 0x60, 0, 0x20)
            ok := and(ok, eq(returndatasize(), 0x20)) // separate statement: Yul evaluates args right to left
            r := mload(0)
        }
        if (!ok) revert HelperCallFailed();
    }

    function _txParam(uint256 id) internal view override returns (uint256) {
        return _q(0, id, 0);
    }

    function _frameParam(uint256 frameIndex, uint256 param) internal view override returns (uint256) {
        return _q(1, frameIndex, param);
    }

    function _sigParam(uint256 sigIndex, uint256 param) internal view override returns (uint256) {
        return _q(2, sigIndex, param);
    }

    function _frameDataLoad(uint256 frameIndex, uint256 offset) internal view override returns (bytes32) {
        return bytes32(_q(3, offset, frameIndex));
    }

    function _recentRoot(uint256 refIndex, uint256 field) internal view override returns (uint256) {
        return _q(4, field, refIndex);
    }

    function _approve(uint256 scope) internal override {
        address h = H;
        bool ok;
        assembly ("memory-safe") {
            let p := mload(0x40)
            mstore(p, 5)
            mstore(add(p, 0x20), scope)
            mstore(add(p, 0x40), 0)
            ok := delegatecall(gas(), h, p, 0x60, 0, 0)
        }
        if (!ok) revert HelperCallFailed();
    }
}
