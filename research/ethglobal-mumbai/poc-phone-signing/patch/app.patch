+package com.enconomy.pop
+
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+
+/** Pure-format checks. The ECDSA round trip lives in research/ethglobal-mumbai/poc-phone-signing/jvm-test. */
+class FrameSigTest {
+    @Test fun lowS() {
+        val r = ByteArray(32) { 1 }
+        val half = FrameSig.HALF_N
+        assertContentEquals(r + half, FrameSig.normalizeLowS(r + half))
+        val halfPlus1 = half.copyOf().also { it[31] = (it[31] + 1).toByte() } // ...a8 -> ...a9, no carry
+        assertContentEquals(r + half, FrameSig.normalizeLowS(r + halfPlus1))
+        val one = ByteArray(32).also { it[31] = 1 }
+        val nMinus1 = FrameSig.N.copyOf().also { it[31] = (it[31] - 1).toByte() } // ...51 -> ...50
+        assertContentEquals(r + one, FrameSig.normalizeLowS(r + nMinus1))
+        assertFailsWith<IllegalArgumentException> { FrameSig.normalizeLowS(r + ByteArray(32)) }
+    }
+
+    @Test fun signerIsLast20OfKeccak() {
+        // generator point G as a "pubkey"; expected from viem keccak256(Gx||Gy).slice(26)
+        val g = "04" +
+            "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" +
+            "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
+        assertEquals("0xd3a9f047ad43d7e2e4e7e491f1fe2e657a2651b6", FrameSig.signerHex(g.hexToBytes()))
+    }
+
+    @Test fun scheme2RefusesHighS() {
+        val pub = byteArrayOf(4) + ByteArray(64) { 7 }
+        assertFailsWith<IllegalArgumentException> { FrameSig.scheme2Bytes(ByteArray(32) { 1 } + FrameSig.N.copyOf().also { it[31] = 0x50 }, pub) }
+        assertEquals(128, FrameSig.scheme2Bytes(ByteArray(32) { 1 } + ByteArray(32) { 1 }, pub).size)
+    }
+}
