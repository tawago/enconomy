# Copy to .env. No keys go in this file. Run with: uv run --env-file .env uvicorn --factory backend.main:create_app

# Required. The core's presence.pubkey from its GET /v1/config: copy it here once, by hand.
# It is pinned on purpose: the backend never fetches it at runtime, or a fake core could vouch for itself.
SAFE_CORE_PRESENCE_PUBKEY=

# Required. Path of the attest key whose qx/qy the deployed guard pins. A new key means BadAttestation on chain.
# Point at the existing file, never copy it. It's never generated here.
SAFE_ATTEST_KEY_FILE=

SAFE_DB=data/safe.sqlite
SAFE_CHAIN_ID=11155111

# An attestation lives this long from the record's finished_at.
SAFE_ATT_TTL_S=900

# Core base URL. Only public routes: the relayer fetches GET /v1/session/{sid}/zk/bundle.
SAFE_CORE_URL=http://127.0.0.1:8000

RPC=https://ethereum-sepolia-rpc.publicnode.com

# Path of the gas key file, outside this repo. Empty: the relayer's own default.
RELAYER_KEY_FILE=
