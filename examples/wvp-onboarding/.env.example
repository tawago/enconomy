# Copy to .env. No keys go in this file. Run with: uv run --env-file .env uvicorn --factory backend.main:create_app --host 0.0.0.0 --port 8400

# Required. The core's presence.pubkey from its GET /v1/config: copy it here once, by hand.
# It is pinned on purpose: the backend never fetches it at runtime, or a fake core could vouch for itself.
ONBOARD_CORE_PRESENCE_PUBKEY=

# Required. The admin phone: its device id from the core app (Device details, "device"), or its 65-byte pubkey in hex.
ONBOARD_ADMIN_DEVICE=

# Required. The passcode for the admin page. Shared, and sent in the clear over plain http.
ONBOARD_ADMIN_PASSCODE=

# Required. The folder holding subname.mjs, relative to this folder or absolute. The whole folder is gitignored, so it
# exists only in the checkout that deployed it. A git worktree has to give that checkout's path.
ONBOARD_ENS_DIR=../../research/ethglobal-mumbai/devnet/ens-v2

# The core's web app, and this backend, as the laptop's browser reaches them.
# The web app must be built with POP_DELIVER_ORIGIN set to the origin of ONBOARD_PUBLIC_URL, or it won't send the record.
ONBOARD_WEB_APP_URL=http://localhost:8001/app/
ONBOARD_PUBLIC_URL=http://localhost:8400

ONBOARD_ORG=blob.eth
ONBOARD_DB=data/onboarding.sqlite

# Must equal the core's POP_CHAIN_ID (GET /v1/config, chain.chain_id), or the core refuses the session with bad_chain.
# It only labels the session. subname.mjs takes its own chain from deployment.json.
ONBOARD_CHAIN_ID=11155111
