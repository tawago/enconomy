# Copy to .env. No keys go in this file. Run with: uv run --env-file .env uvicorn --factory backend.main:create_app
# The sidecar runs next to it: cd sidecar && npm ci && node index.mjs

# Required. The core's presence.pubkey from its GET /v1/config: copy it here once, by hand.
# It is pinned on purpose: the backend never fetches it at runtime, or a fake core could vouch for itself.
WID_CORE_PRESENCE_PUBKEY=

# Required. From the World ID developer portal.
WID_RP_ID=
WID_APP_ID=

# Required. Path of the RP signing key (secp256k1 hex, 0600). Point at the existing file, never copy it.
WID_SIGNING_KEY_FILE=

WID_DB=data/world-id.sqlite
WID_SIDECAR=http://127.0.0.1:8787
WID_PORTAL=https://developer.world.org

# Where World App sends the phone back. The app in app/ handles this link, change both together.
WID_RETURN_TO=enconomy://worldid
