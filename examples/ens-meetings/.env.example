# Copy to .env. No keys go in this file. Run with: uv run --env-file .env uvicorn --factory backend.main:create_app

# Required. The core's presence.pubkey from its GET /v1/config: copy it here once, by hand.
# It is pinned on purpose: the backend never fetches it at runtime, or a fake core could vouch for itself.
ENS_CORE_PRESENCE_PUBKEY=

# Core base URL. Only used for public routes: the bridge fetches GET /v1/session/{sid}/zk/bundle.
ENS_CORE_URL=http://127.0.0.1:8000

ETH_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Path of the hot key file, outside this repo. The key itself never goes here.
ENS_KEY_FILE=~/.enconomy/ens-sepolia.key

ENS_DB=data/ens.sqlite
ENS_DEPLOYMENTS=contracts/deployments/sepolia.json
ENS_ZK_DEPLOYMENTS=contracts/deployments/zk-sepolia.json

# Oldest device statement a claim accepts. The app re-fetches a stale one from the core.
ENS_STATEMENT_MAX_AGE_S=3600
