{
  "manifest_version": 3,
  "name": "WVP (test only)",
  "key": "",
  "version": "0.0.5",
  "description": "Proves you hold a credential for an ENS name or address, bound to the site's real origin. Throwaway keys only.",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://issuer.test:8801/*",
    "http://keys.test:8804/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://issuer.test:8801/*"
      ],
      "js": [
        "page-api.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://issuer.test:8801/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*.test/*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "action": {
    "default_title": "WVP",
    "default_popup": "popup.html"
  }
}