# Copy to server/.env (gitignored). `python -m pop` reads it; real env vars win.
# Full list and meaning: server/README.md (env table).

# --- listen ---
POP_HOST=0.0.0.0
POP_PORT=8001

# --- World ID (developer.world.org portal) ---
POP_WORLDID_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POP_WORLDID_RP_ID=rp_xxxxxxxxxxxxxxxx
# RP signer key file (secp256k1 hex, 0600, gitignored); default data/worldid-rp.key
# POP_WORLDID_SIGNING_KEY_FILE=data/worldid-rp.key
POP_WORLDID_SIDECAR=http://127.0.0.1:8787
# Sandbox World ID (World ID Simulator) for test sessions; the free-team iPhone uses it.
POP_WORLDID_SANDBOX=1

# --- demo switches ---
# "Host with World ID (test)" in the app needs the `test` context kind.
POP_TEST_KINDS=1
# Free-team iPhone / fake phones enroll without attestation.
POP_ALLOW_UNATTESTED=1
# Device ids that may be unattested and still get a chain attestation (comma list).
# POP_UNATTESTED_ALLOW=

# --- chain ---
# POP_CHAIN_ID=11155111
# POP_ATTEST_KEY_FILE=data/attest.pem

# --- ZK (Noir option A, bb v5.0.0-nightly.20260522) ---
# POP_ZK_VERIFIER=~/.enconomy/zk/pinned/bin/bb
# POP_ZK_PROVER=~/.enconomy/zk/android/target/release/zkprove
# POP_ZK_DIR=
